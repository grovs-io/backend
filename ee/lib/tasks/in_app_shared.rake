# frozen_string_literal: true

# Copies the in-app schema and shared cases into SDK checkouts, or checks the copies are current.
namespace :in_app_shared do
  desc "Copy the in-app files into the SDK checkouts: [IN_APP_SHARED_WORKSPACE=<dir holding the SDK checkouts>] [FORCE=1]"
  task(copy: :environment) { puts "copied to #{InAppShared.copy(force: ENV['FORCE'] == '1').join(', ')}" }

  desc "Fail when an SDK checkout is missing or holds an older copy: [IN_APP_SHARED_WORKSPACE=<dir>]"
  task(check: :environment) do
    behind = InAppShared.stale
    abort "out of date: #{behind.join(', ')}. Run: bundle exec rake in_app_shared:copy" if behind.any?
    puts "shared in-app files are current"
  end
end

module InAppShared
  SOURCE = File.expand_path("../../config/in_app", __dir__)
  FILES = %w[definition.schema.json cases.schema.json cases.json README.md].freeze
  TARGETS = {
    "grovs-js" => "test/in-app-shared",
    "grovs-ios" => "Tests/grovs-iosTests/Fixtures/in-app-shared",
    "grovs-android" => "Grovs/Grovs/src/test/resources/in-app-shared"
  }.freeze
  # Folder names a checkout may have besides its key; case matters on Linux.
  CHECKOUT_NAMES = { "grovs-android" => %w[grovs-Android] }.freeze
  KOTLIN_MAX_BYTES = 60_000
  DASHBOARD_CASES = "ee/lib/__tests__/fixtures/in-app-shared/cases.json"
  NoCheckouts = Class.new(StandardError)
  EditedCopy = Class.new(StandardError)

  module_function

  def workspace = ENV.fetch("IN_APP_SHARED_WORKSPACE") { File.expand_path("../../../../..", __dir__) }

  def manifest(dir)
    FILES.index_with { |name| Digest::SHA256.file(File.join(dir, name)).hexdigest }
  end

  def recorded(dir)
    JSON.parse(File.read(File.join(dir, "manifest.json")))
  rescue Errno::ENOENT, JSON::ParserError
    nil
  end

  def complete?(dir) = FILES.all? { |name| File.file?(File.join(dir, name)) }

  def checkout(root, repo)
    [repo, *CHECKOUT_NAMES.fetch(repo, [])].map { |name| File.join(root, name) }.find { |dir| File.directory?(dir) }
  end

  # A run that finds no checkout has checked nothing, so it must not pass.
  def targets(root)
    found = TARGETS.filter_map { |repo, path| (home = checkout(root, repo)) && [repo, File.join(home, path), home] }
    raise NoCheckouts, "no SDK checkout under #{root}; set IN_APP_SHARED_WORKSPACE" if found.empty?

    found
  end

  def edited?(dir) = complete?(dir) && !recorded(dir).nil? && recorded(dir) != manifest(dir)

  def reserved_event_names(source: SOURCE) = JSON.parse(File.read(File.join(source, "reserved_events.json"))).fetch("names")
  def bridge_script(source: SOURCE) = File.read(File.join(source, "bridge.js"))

  # bridge.js is multi-line, so this needs Swift's triple-quoted raw string, not the single-line #"..."# form.
  # It closes on `"""` followed by the same run of `#`; use one more than the content holds. The closing
  # delimiter sits at column 0 so Swift's multi-line de-indenting strips nothing from the content.
  def swift_raw_string(content)
    longest = content.scan(/"""(#+)/).map { |m| m[0].length }.max || 0
    fence = "#" * (longest + 1)
    body = content.end_with?("\n") ? content : "#{content}\n"
    "#{fence}\"\"\"\n#{body}\"\"\"#{fence}"
  end

  def js_reserved_events_ts(source: SOURCE)
    names = reserved_event_names(source: source).map { |n| "  #{n.to_json}," }.join("\n")
    <<~TS
      // Generated by `rake in_app_shared:copy` from ee/config/in_app/reserved_events.json. Do not edit.
      export const RESERVED_EVENT_NAMES: readonly string[] = [
      #{names}
      ];
    TS
  end

  def ios_bridge_swift(source: SOURCE)
    names = reserved_event_names(source: source).map { |n| "    #{n.to_json}" }.join(",\n")
    <<~SWIFT
      // Generated by `rake in_app_shared:copy` from ee/config/in_app/bridge.js and reserved_events.json. Do not edit.
      enum InAppBridge {
          static let script = #{swift_raw_string(bridge_script(source: source))}
          static let reservedEvents: Set<String> = [
      #{names}
          ]
      }
    SWIFT
  end

  # A Kotlin raw string has no escape for """ and starts a template at $.
  def kotlin_raw_string(content)
    raise ArgumentError, %(bridge.js holds """, which a Kotlin raw string cannot carry) if content.include?('"""')
    raise ArgumentError, "bridge.js is over #{KOTLIN_MAX_BYTES} bytes, too big for one JVM string" if content.bytesize > KOTLIN_MAX_BYTES

    escaped = content.gsub("$") { "${'$'}" }
    "\"\"\"#{escaped}\"\"\""
  end

  def android_bridge_kotlin(source: SOURCE)
    names = reserved_event_names(source: source).map { |n| "        #{n.to_json.gsub('$') { '\\$' }}," }.join("\n")
    <<~KOTLIN
      // Generated by `rake in_app_shared:copy` from ee/config/in_app/bridge.js and reserved_events.json. Do not edit.
      package io.grovs.inapp

      internal object InAppBridge {
          val SCRIPT: String = #{kotlin_raw_string(bridge_script(source: source))}

          val RESERVED_EVENTS: Set<String> = setOf(
      #{names}
          )
      }
    KOTLIN
  end

  # Regenerated on every copy and compared byte-for-byte to detect staleness; no separate manifest needed.
  def runtime_files(repo, dir, source: SOURCE)
    case repo
    when "grovs-js"
      { File.join(dir, "src/inapp/bridge.js") => bridge_script(source: source),
        File.join(dir, "src/inapp/reserved-events.generated.ts") => js_reserved_events_ts(source: source) }
    when "grovs-ios"
      { File.join(dir, "Sources/Grovs/model/inapp/InAppBridge.generated.swift") => ios_bridge_swift(source: source) }
    when "grovs-android"
      { File.join(dir, "Grovs/Grovs/src/main/java/io/grovs/inapp/InAppBridge.generated.kt") => android_bridge_kotlin(source: source) }
    else
      {}
    end
  end

  def write_runtime(repo, dir, source: SOURCE)
    runtime_files(repo, dir, source: source).each do |path, content|
      FileUtils.mkdir_p(File.dirname(path))
      File.write(path, content)
    end
  end

  def runtime_stale?(repo, dir, source: SOURCE)
    runtime_files(repo, dir, source: source).any? { |path, content| !File.exist?(path) || File.read(path) != content }
  end

  def copy(root: workspace, source: SOURCE, force: false)
    found = targets(root)
    edited = found.select { |_, dir| edited?(dir) }.map(&:first)
    raise EditedCopy, "edited by hand: #{edited.join(', ')}. Re-run with FORCE=1 to overwrite" if edited.any? && !force

    found.map do |repo, dir, home|
      FileUtils.mkdir_p(dir)
      FILES.each { |name| FileUtils.cp(File.join(source, name), File.join(dir, name)) }
      File.write(File.join(dir, "manifest.json"), "#{JSON.pretty_generate(manifest(source))}\n")
      write_runtime(repo, home, source: source)
      repo
    end + copy_dashboard_cases(root, source)
  end

  # The dashboard's link and html checks run cases.json; it sits in the workspace or beside it.
  def dashboard_cases(root)
    [File.join(root, "grovs-web-app"), File.expand_path("../grovs-web-app", root)]
      .find { |dir| File.directory?(dir) }&.then { |dir| File.join(dir, DASHBOARD_CASES) }
  end

  def copy_dashboard_cases(root, source)
    path = dashboard_cases(root) or return []
    FileUtils.mkdir_p(File.dirname(path))
    FileUtils.cp(File.join(source, "cases.json"), path)
    ["grovs-web-app"]
  end

  def stale(root: workspace, source: SOURCE)
    wanted = manifest(source)
    targets(root).reject do |repo, dir, home|
      complete?(dir) && manifest(dir) == wanted && recorded(dir) == wanted && !runtime_stale?(repo, home, source: source)
    end.map(&:first) + dashboard_stale(root, source)
  end

  def dashboard_stale(root, source)
    path = dashboard_cases(root)
    path && (!File.exist?(path) || !FileUtils.identical?(path, File.join(source, "cases.json"))) ? ["grovs-web-app"] : []
  end
end
