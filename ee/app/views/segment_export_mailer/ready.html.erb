        <h2 style="color: #132441; font-weight: 600; margin: 0 0 24px 0;">Your segment export is ready</h2>

        <p style="margin: 0 0 20px 0; color: #4a4a4a; font-size: 15px;">Hello,</p>

        <p style="margin: 0 0 20px 0; color: #4a4a4a; font-size: 15px;">
          The export you requested has finished. The file is kept for <strong style="color: #132441;">24 hours</strong>,
          then deleted, so download it soon.
        </p>

        <div style="background-color: #f8f9fa; border-radius: 6px; padding: 20px; margin: 30px 0;">
          <table cellpadding="0" cellspacing="0" border="0" role="presentation">
            <tr>
              <td style="vertical-align: middle; padding-right: 15px;">
                <img src="<%= Grovs::Assets::DOWNLOAD_ICON %>" alt="File" style="width: 20px; height: auto; display: block; border: 0;">
              </td>
              <td style="vertical-align: middle;">
                <h4 style="margin: 0; color: #132441; font-weight: 600; font-size: 15px;"><%= @export.segment.name %></h4>
                <p style="margin: 5px 0 0; color: #6b7c93; font-size: 13px;">
                  CSV file • <%= number_with_delimiter(@export.rows.to_i) %> <%= "user".pluralize(@export.rows.to_i) %> • Deleted after 24 hours
                </p>
              </td>
            </tr>
          </table>

          <div style="margin-top: 20px;">
            <a href="<%= @segment_url %>"
               style="display: inline-block; background-color: #2A86FF; color: #ffffff; padding: 12px 28px; text-decoration: none; border-radius: 4px; font-weight: 500; font-size: 15px;">
              Open segment
            </a>
          </div>
        </div>

        <p style="margin: 0 0 20px 0; color: #4a4a4a; font-size: 15px;">
          The file is in the <strong style="color: #132441;">Exports</strong> panel on the segment's Overview tab
          (Audience → Segments → <%= @export.segment.name %>).
        </p>
