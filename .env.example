# =============================================================================
# Linksquared Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (React Dashboard)
# -----------------------------------------------------------------------------
REACT_HOST_PROTOCOL=http://
REACT_HOST=localhost:3001
REACT_HOST_CHANGE_PASSWORD_PATH=/new-password
REACT_HOST_ACCEPT_INVITE_PATH=/accept-invite
REACT_HOST_DASHBOARD_PATH=/

# Beta dashboard (optional)
# REACT_BETA_HOST_PROTOCOL=https://
# REACT_BETA_HOST=beta.example.com

# -----------------------------------------------------------------------------
# Docker image (docker-compose.yml). Pin a release, e.g. ghcr.io/grovs-io/backend:1.4.0
# -----------------------------------------------------------------------------
# GROVS_IMAGE=ghcr.io/grovs-io/backend:latest

# -----------------------------------------------------------------------------
# Server / Backend
# -----------------------------------------------------------------------------
SERVER_HOST_PROTOCOL=http://
SERVER_HOST=localhost:3000

# Domain configuration
# DOMAIN_LIVE=sqd.link        # defaults to sqd.link if not set
# DOMAIN_TEST=test-sqd.link   # defaults to test-sqd.link if not set

# Custom domains via Cloudflare for SaaS (optional, off by default).
# The feature stays fully dormant unless CUSTOM_DOMAINS_ENABLED=true AND all three
# Cloudflare credentials below are set. Self-hosters without Cloudflare can ignore this.
# CUSTOM_DOMAINS_ENABLED=false
# CLOUDFLARE_API_TOKEN=          # zone-scoped token with SSL/custom-hostname edit rights
# CLOUDFLARE_ZONE_ID=            # the zone hosting the fallback origin
# CLOUDFLARE_SAAS_CNAME_TARGET=proxy.sqd.link  # CNAME target customers point at

# Preview URL for link previews
PREVIEW_BASE_URL=http://preview.lvh.me:3000

# SSO failure redirect
# SSO_AUTHENTICATION_ENDPOINT=http://localhost:3001/login

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# For production, set DATABASE_URL instead:
# DATABASE_URL=postgres://user:password@host:5432/linksquared_production

# -----------------------------------------------------------------------------
# Rails secret (required in production; docker compose uses RAILS_ENV=production)
# Generate with: bin/rails secret   (or: openssl rand -hex 64)
# -----------------------------------------------------------------------------
SECRET_KEY_BASE=generate_with_bin_rails_secret

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# ActiveRecord Encryption
# Generate with: bin/rails db:encryption:init
# -----------------------------------------------------------------------------
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=your_primary_key_here
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=your_deterministic_key_here
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=your_salt_here

# -----------------------------------------------------------------------------
# AWS S3 (file storage via ActiveStorage)
# -----------------------------------------------------------------------------
AWS_S3_KEY_ID=your_aws_key_id
AWS_S3_ACCESS_KEY=your_aws_secret_key
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
S3_ASSET_PREFIX=http://localhost:3000

# -----------------------------------------------------------------------------
# Email (SendGrid)
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=your_sendgrid_api_key

# -----------------------------------------------------------------------------
# Payments (Stripe)
# -----------------------------------------------------------------------------
STRIPE_API_KEY=your_stripe_api_key
STRIPE_STANDARD_PRICE_ID=your_stripe_price_id
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# -----------------------------------------------------------------------------
# OAuth / SSO
# -----------------------------------------------------------------------------

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft Office365 OAuth
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# Google Pub/Sub IAP webhook auth (EE). Set to enforce the OIDC token's audience and
# push service-account identity; unset means only signature+issuer are checked.
# GOOGLE_PUBSUB_AUDIENCE=
# GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------

# Admin API key (used for admin/automation endpoints)
ADMIN_API_KEY=generate_a_secure_random_key

# Diagnostics API key
DIAGNOSTICS_API_KEY=generate_a_secure_random_key

# Webhook authentication key for quota notifications
SENT_QUOTAS_WEBHOOK_KEY=generate_a_secure_random_key

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
PUBLIC_GO_PROJECT_IDENTIFIER=public-go-links
PUBLIC_GO_PROJECT_IDENTIFIER_ID=1
FREE_MAU_COUNT=10000

# Comma-separated instance IDs exempt from billing
# FREE_PASS_PROJECT_IDS=

# -----------------------------------------------------------------------------
# Volume Discounts (optional)
# -----------------------------------------------------------------------------
# FIRST_DISCOUNT_MAUS_THRESHOLD=1000000
# FIRST_DISCOUNT_PERCENTAGE=25
# SECOND_DISCOUNT_MAUS_THRESHOLD=1500000
# SECOND_DISCOUNT_PERCENTAGE=30

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry, optional)
# -----------------------------------------------------------------------------
# OTEL_EXPORTER=otlp
# OTEL_SERVICE_NAME=linksquared-development
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------------
# Deployment (Kamal, optional)
# -----------------------------------------------------------------------------
# KAMAL_REGISTRY_PASSWORD=your_docker_registry_token

# -----------------------------------------------------------------------------
# Default Assets (optional)
# -----------------------------------------------------------------------------
# Fallback logo and social preview image used when apps/links have no custom assets.
# DEFAULT_LOGO_URL=https://your-bucket.s3.region.amazonaws.com/logo.svg
# DEFAULT_SOCIAL_PREVIEW_URL=https://your-bucket.s3.region.amazonaws.com/social-preview.jpg
# DEFAULT_LINK_TITLE=grovs
# DEFAULT_LINK_SUBTITLE=Dynamic links, attributions, and referrals across mobile and web platforms.

# Email template assets (used in mailer views)
# ASSET_LOGO_LARGE_URL=https://your-bucket.s3.region.amazonaws.com/logo-large.png
# ASSET_LOGO_SQUARE_URL=https://your-bucket.s3.region.amazonaws.com/logo-square.png
# ASSET_ATTENTION_ICON_URL=https://your-bucket.s3.region.amazonaws.com/attention-icon.png
# ASSET_DOWNLOAD_ICON_URL=https://your-bucket.s3.region.amazonaws.com/download-icon.png
# ASSET_LINKEDIN_ICON_URL=https://your-bucket.s3.region.amazonaws.com/linkedin.png
# ASSET_GITHUB_ICON_URL=https://your-bucket.s3.region.amazonaws.com/github.png

# -----------------------------------------------------------------------------
# MCP (Model Context Protocol)
# -----------------------------------------------------------------------------
# Enables AI tools (Claude, Cursor, Windsurf, ChatGPT) to manage links,
# campaigns, and analytics via the MCP protocol. Requires the mcp. subdomain
# (e.g. mcp.yourdomain.com) pointed at this backend.
#
# URL of the dashboard's OAuth consent page. The backend redirects browsers
# here when MCP clients authorize. Must match your dashboard's public URL.
# Default: http://localhost:3001/mcp/authorize (dashboard local dev port)
# Production example: https://app.yourdomain.com/mcp/authorize
MCP_CONSENT_URL=http://localhost:3001/mcp/authorize

# -----------------------------------------------------------------------------
# ClickHouse (analytics)
# -----------------------------------------------------------------------------
# docker-compose.yml overrides CLICKHOUSE_URL with its own clickhouse service.
CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_DATABASE=grovs_development
CLICKHOUSE_WRITE_ENABLED=true
CLICKHOUSE_READ_ENABLED=true
# ClickHouse is the event store; PG keeps a spill fallback. Requires write+read above.
CLICKHOUSE_PRIMARY=true
# Dashboard counts from ClickHouse rollups (implied by CLICKHOUSE_PRIMARY).
CLICKHOUSE_ANALYTICS_ROLLUPS_READ_ENABLED=true
# Per-visitor attribution from ClickHouse.
CLICKHOUSE_ATTRIBUTION_READ_ENABLED=true
# Link list and link metrics from ClickHouse.
CLICKHOUSE_LINK_DIMENSIONS_READ_ENABLED=true
# Revenue from the ledger (implied by CLICKHOUSE_PRIMARY).
REVENUE_READS_FROM_LEDGER=true
# Rebuild the current month's rollups every minute (fresher dashboards, more CH load).
CLICKHOUSE_ROLLUP_FAST_LANE=true
# Dashboard cache lifetime in seconds.
DASHBOARD_CACHE_TTL_SECONDS=60
# Event-derived stats live in ClickHouse only; PostgreSQL stat tables are not written.
PG_SHADOW_WRITES=false
# CH canonical insert timeout in seconds (bounded retry -> DLQ).
# CLICKHOUSE_CANONICAL_INSERT_TIMEOUT=5
# CH insert timeout in seconds when CLICKHOUSE_PRIMARY=true.
# CLICKHOUSE_PRIMARY_INSERT_TIMEOUT=2

# -----------------------------------------------------------------------------
# Performance Tuning (optional)
# -----------------------------------------------------------------------------
# WEB_CONCURRENCY=8
# RAILS_MAX_THREADS=32
# Sidekiq batch_events worker concurrency (event processor). Default 3.
# SIDEKIQ_BATCH_CONCURRENCY=3

# -----------------------------------------------------------------------------
# Client IP resolution (security)
# -----------------------------------------------------------------------------
# request.remote_ip is read from this proxy-set header (X-Forwarded-For is
# client-spoofable). Default "CF-Connecting-IP" suits Cloudflare. Behind nginx,
# set to the header your proxy authoritatively sets (e.g. X-Real-IP). A list
# value resolves to its LAST entry, so behind an AWS ALB (append mode, app only
# reachable from the ALB) set X-Forwarded-For. Set empty to disable and rely on
# Rails trusted_proxies instead.
# CLIENT_IP_HEADER=CF-Connecting-IP

# -----------------------------------------------------------------------------
# ClickHouse read flags (optional; enable in this order after writes are on)
# -----------------------------------------------------------------------------
# Dashboard counts from ClickHouse rollups.
# CLICKHOUSE_ANALYTICS_ROLLUPS_READ_ENABLED=false
# Per-visitor attribution from ClickHouse.
# CLICKHOUSE_ATTRIBUTION_READ_ENABLED=false
# Link list and link metrics from ClickHouse.
# CLICKHOUSE_LINK_DIMENSIONS_READ_ENABLED=false
# Rebuild the current month's rollups every minute (fresher dashboards, more CH load).
# CLICKHOUSE_ROLLUP_FAST_LANE=false
# Dashboard cache lifetime in seconds.
# DASHBOARD_CACHE_TTL_SECONDS=300
# Stop writing event-derived stats to PostgreSQL. Only valid with CLICKHOUSE_PRIMARY=true.
# PG_SHADOW_WRITES=true

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Load the Enterprise Edition (ee/): IAP revenue, audit log, enterprise SSO and SCIM.
# GROVS_EE=false
# Single-tenant self-hosted mode: assets served through the app, no SaaS seed data,
# custom domains entitled without billing, audit log always on.
# GROVS_SELF_HOSTED=false
# Branch/AppsFlyer migration endpoints (503 when off).
# MIGRATIONS_ENABLED=false
# Custom domains without Cloudflare: customers CNAME to SELF_HOSTED_INGRESS_HOST.
# CUSTOM_DOMAINS_PROVIDER=cloudflare   # or "manual"
# SELF_HOSTED_INGRESS_HOST=            # defaults to SERVER_HOST

# -----------------------------------------------------------------------------
# First-run bootstrap (self-hosted; read by db:seed and grovs:ensure_bootstrap_admin)
# -----------------------------------------------------------------------------
# Creates the first admin user without SMTP or SSO. Both or neither.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Fixed Doorkeeper client credentials for the dashboard. Both or neither.
# OAUTH_CLIENT_UID=
# OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email via SMTP (alternative to SendGrid)
# -----------------------------------------------------------------------------
# MAILER_DELIVERY_METHOD=smtp
# MAILER_FROM=Grovs <noreply@example.com>
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_DOMAIN=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true

# -----------------------------------------------------------------------------
# S3-compatible storage and GeoIP
# -----------------------------------------------------------------------------
# Endpoint for MinIO/Ceph; leave unset for AWS S3.
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# MaxMind GeoLite2 City database (not bundled; geo features degrade gracefully without it).
# GEOIP_DB_PATH=/app/db/GeoLite2-City.mmdb

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Production log level: debug, info, warn, error, fatal.
# RAILS_LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Docker Compose (self-hosted)
# -----------------------------------------------------------------------------
# docker-compose.yml sets DATABASE_URL, REDIS_URL and GROVS_SELF_HOSTED itself.
# Host port for the API (SERVER_HOST above must match, e.g. localhost:3000).
# WEB_PORT=3000
# Uploaded assets: "local" stores them in the storage volume and serves them
# through the app; set "amazon" plus the AWS_S3_* variables to use S3/MinIO.
# ACTIVE_STORAGE_SERVICE=local
# Database credentials used by the db container.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=grovs
# Password for the ClickHouse "grovs" user (clickhouse profile only).
# CLICKHOUSE_PASSWORD=grovs
